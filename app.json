{
  "expo": {
    "name": "CurRENT",
    "slug": "current-fintech-rental-marketplace",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "current",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your rental listings, profile and condition evidence.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      }
    }
  }
}
